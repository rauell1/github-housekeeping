{
  "name": "github-housekeeping",
  "version": "1.3.0",
  "description": "Zero-dependency tool for GitHub Follow & Repository Housekeeping: audit non-followers, curate a protected allowlist, batch unfollow with undo, and safely archive or delete unused repositories.",
  "type": "module",
  "bin": {
    "github-housekeeping": "./server.mjs"
  },
  "files": [
    "server.mjs",
    "lib/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Roy Otieno (@rauell1)",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx wrangler deploy"
  },
  "keywords": [
    "github",
    "followers",
    "following",
    "housekeeping",
    "unfollow",
    "gh-cli",
    "dashboard",
    "repositories",
    "archive",
    "cleanup"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rauell1/github-housekeeping.git"
  },
  "homepage": "https://github.com/rauell1/github-housekeeping#readme",
  "bugs": {
    "url": "https://github.com/rauell1/github-housekeeping/issues"
  },
  "license": "MIT"
}
